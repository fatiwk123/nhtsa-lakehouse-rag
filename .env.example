# Copy to .env:  cp .env.example .env

# --- Postgres (Iceberg catalog, Dagster storage, pgvector) ---
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse
POSTGRES_DB=lakehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ICEBERG_CATALOG_DB=lakehouse
DAGSTER_DB=dagster
RAG_DB=rag

# --- MinIO ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://localhost:9000
LAKEHOUSE_BUCKET=lakehouse

# --- NHTSA ingestion scope ---
# Start small (1-2 makes), then widen. NHTSA only covers vehicles sold in the US.
NHTSA_MAKES=VOLKSWAGEN
# Range "2018-2020" or list "2019,2021"
NHTSA_MODEL_YEARS=2018-2020
# Optional comma-separated model filter (empty = all models of the make)
NHTSA_MODELS=
NHTSA_MAX_WORKERS=4
