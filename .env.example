# Copy to .env:  cp .env.example .env

# --- Postgres (Iceberg catalog, Dagster storage, pgvector) ---
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse
POSTGRES_DB=lakehouse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ICEBERG_CATALOG_DB=lakehouse
DAGSTER_DB=dagster
RAG_DB=rag

# --- MinIO ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://localhost:9000
LAKEHOUSE_BUCKET=lakehouse

# --- NHTSA ingestion scope ---
# Start small (1-2 makes), then widen. NHTSA only covers vehicles sold in the US.
NHTSA_MAKES=VOLKSWAGEN
# Range "2018-2020" or list "2019,2021"
NHTSA_MODEL_YEARS=2018-2020
# Optional comma-separated model filter (empty = all models of the make)
NHTSA_MODELS=
NHTSA_MAX_WORKERS=2
# Minimum delay between two requests to the public NHTSA API (per process)
NHTSA_MIN_INTERVAL_S=0.5
# Recall PDFs: document types (file prefix) and cap per campaign
NHTSA_DOC_TYPES=RCLRPT,RCMN
NHTSA_MAX_DOCS_PER_CAMPAIGN=4

# --- Alerting (optional): Slack/Teams/Discord incoming webhook, called when a run fails ---
ALERT_WEBHOOK_URL=

# --- Assistant (phase 4) ---
# Local LLM served by Ollama (tool calling). Bigger = better answers, slower on CPU (qwen3:4b-instruct = good tool calling at ~2.5 GB; avoid "thinking" models on CPU).
OLLAMA_MODEL=qwen3:4b-instruct
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_TOP_K=5
RAG_CANDIDATES=30
# Cross-encoder logit under which the best passage is considered irrelevant -> "je ne sais pas".
RAG_MIN_RERANK_SCORE=0.0
